---
// AtmosphericBg.astro - Atmospheric background with animated gradient mesh, noise texture, and ambient canvas
---

<div id="atm-bg" aria-hidden="true">
  <!-- Layer 1: Animated gradient mesh -->
  <div class="atm-gradient"></div>
  
  <!-- Layer 2: Subtle organic noise texture -->
  <div class="atm-noise"></div>
  
  <!-- Layer 3: Ambient glow canvas -->
  <canvas id="atm-canvas" class="atm-canvas"></canvas>
  
  <!-- Layer 4: Vignette gradient overlay for text readability -->
  <div class="atm-vignette"></div>
</div>

<style>
  #atm-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    background-color: #0b0a09;
    pointer-events: none;
  }

  /* Layer 1: Animated gradient mesh */
  .atm-gradient {
    position: absolute;
    inset: -20%;
    width: 140%;
    height: 140%;
    background: 
      radial-gradient(ellipse 70% 55% at 20% 25%, rgba(18, 45, 100, 0.65) 0%, transparent 60%),
      radial-gradient(ellipse 60% 75% at 85% 65%, rgba(60, 25, 10, 0.6) 0%, transparent 55%),
      radial-gradient(ellipse 90% 50% at 50% 100%, rgba(12, 35, 70, 0.55) 0%, transparent 50%),
      radial-gradient(ellipse 45% 45% at 65% 15%, rgba(20, 60, 35, 0.5) 0%, transparent 45%),
      #0b0a09;
    animation: atmDrift 20s ease-in-out infinite alternate;
    transform-origin: 50% 50%;
    will-change: transform, filter;
  }

  @keyframes atmDrift {
    0% {
      transform: scale(1.0) translate(0%, 0%) rotate(0deg);
      filter: hue-rotate(0deg) brightness(1.0);
    }
    33% {
      transform: scale(1.05) translate(-1.5%, 1%) rotate(0.4deg);
      filter: hue-rotate(10deg) brightness(1.05);
    }
    66% {
      transform: scale(1.03) translate(1.5%, -1%) rotate(-0.3deg);
      filter: hue-rotate(-8deg) brightness(0.95);
    }
    100% {
      transform: scale(1.07) translate(-1%, 1.5%) rotate(0.6deg);
      filter: hue-rotate(12deg) brightness(1.08);
    }
  }

  /* Layer 2: Organic noise texture (SVG fractal turbulence) */
  .atm-noise {
    position: absolute;
    inset: 0;
    opacity: 0.18;
    mix-blend-mode: soft-light;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    animation: noisePan 10s linear infinite;
  }

  @keyframes noisePan {
    0% { background-position: 0 0; }
    100% { background-position: 200px 200px; }
  }

  /* Layer 3: Canvas */
  .atm-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.9;
  }

  /* Layer 4: Vignette — gentle fade at top and bottom only, keep center clear */
  .atm-vignette {
    position: absolute;
    inset: 0;
    background: 
      linear-gradient(to bottom, rgba(11, 10, 9, 0.5) 0%, transparent 20%, transparent 70%, rgba(11, 10, 9, 0.8) 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .atm-gradient, .atm-noise {
      animation: none;
    }
  }
</style>

<script>
  // Ambient glow particles canvas
  const canvas = document.getElementById('atm-canvas') as HTMLCanvasElement | null;
  if (canvas) {
    const ctx = canvas.getContext('2d');
    if (ctx) {
      const resize = () => {
        canvas.width = window.innerWidth;
        canvas.height = window.innerHeight;
      };
      resize();
      window.addEventListener('resize', resize, { passive: true });

      const PARTICLES = 18;
      const palette = [
        [240, 175, 70],  // warm amber
        [40, 110, 210],  // cool indigo/blue
        [60, 190, 145],  // sea teal
        [190, 80, 50],   // warm ember
        [125, 75, 210],  // subtle violet
        [200, 140, 60],  // gold
      ];

      const particles = Array.from({ length: PARTICLES }, (_, i) => ({
        x: Math.random(),
        y: Math.random(),
        vx: (Math.random() - 0.5) * 0.00008,
        vy: (Math.random() - 0.5) * 0.00006,
        r: 0.15 + Math.random() * 0.22,
        color: palette[i % palette.length],
        phase: Math.random() * Math.PI * 2,
        speed: 0.2 + Math.random() * 0.3,
      }));

      let t = 0;
      let animId: number;

      const draw = () => {
        t += 0.003;
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        particles.forEach(p => {
          p.x += p.vx;
          p.y += p.vy;

          if (p.x < -0.2) p.x = 1.2;
          if (p.x > 1.2) p.x = -0.2;
          if (p.y < -0.2) p.y = 1.2;
          if (p.y > 1.2) p.y = -0.2;

          const pulse = 0.5 + 0.5 * Math.sin(t * p.speed + p.phase);
          const alpha = 0.12 + pulse * 0.16;
          const radius = (p.r * Math.min(canvas.width, canvas.height)) * (0.85 + pulse * 0.3);
          const px = p.x * canvas.width;
          const py = p.y * canvas.height;

          const grad = ctx.createRadialGradient(px, py, 0, px, py, radius);
          const [r, g, b] = p.color;
          grad.addColorStop(0, `rgba(${r},${g},${b},${alpha})`);
          grad.addColorStop(0.45, `rgba(${r},${g},${b},${alpha * 0.35})`);
          grad.addColorStop(1, `rgba(${r},${g},${b},0)`);

          ctx.fillStyle = grad;
          ctx.beginPath();
          ctx.arc(px, py, radius, 0, Math.PI * 2);
          ctx.fill();
        });

        animId = requestAnimationFrame(draw);
      };

      // Check prefers-reduced-motion
      const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (!motionQuery.matches) {
        draw();
      }

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          cancelAnimationFrame(animId);
        } else if (!motionQuery.matches) {
          draw();
        }
      });
    }
  }
</script>
