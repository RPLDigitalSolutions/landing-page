---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { getDb } from '../../db';
import { articles } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const db = getDb(env as any);
const post = await db.query.articles.findFirst({
  where: eq(articles.slug, slug)
});

if (!post) {
  return Astro.redirect('/404');
}

const rawText = post.content.replace(/<[^>]+>/g, '').replace(/\s+/g, ' ').trim();
let plainTextDescription = rawText;
if (rawText.length > 160) {
  const truncated = rawText.substring(0, 160);
  const lastSpace = truncated.lastIndexOf(' ');
  plainTextDescription = (lastSpace > 0 ? truncated.substring(0, lastSpace) : truncated) + '...';
}

const words = rawText.split(' ').filter(Boolean).length;
const readTime = `${Math.max(1, Math.ceil(words / 180))} min read`;

const formattedDate = new Date(post.createdAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});
---

<Layout title={post.title} description={plainTextDescription} ogType="article" twitterCard="summary_large_image">
  <div class="max-w-4xl mx-auto px-6 md:px-12">
    <Header client:load />

    <main class="pt-32 md:pt-44 pb-24 md:pb-36 min-h-[80vh]">
      {/* Top Breadcrumb */}
      <div class="mb-8">
        <a 
          href="/blog" 
          class="inline-flex items-center gap-2 font-mono text-[0.6875rem] uppercase tracking-[0.2em] text-paper/40 hover:text-paper hover:underline underline-offset-4 transition-colors"
        >
          <span>Dispatches</span>
          <span class="text-paper/20">/</span>
          <span>Index</span>
        </a>
      </div>

      {/* Article Header */}
      <header class="mb-14 pb-12 border-b border-rule">
        <div class="flex items-center gap-3 font-mono text-xs text-paper/40 mb-6">
          <time datetime={new Date(post.createdAt).toISOString()} class="uppercase tracking-widest text-[0.6875rem]">
            {formattedDate}
          </time>
          <span class="text-paper/20">·</span>
          <span class="text-[0.6875rem]">{readTime}</span>
          <span class="text-paper/20">·</span>
          <span class="text-[0.6875rem] text-paper/50">RPL Engineering Lab</span>
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-serif font-light text-paper leading-[1.08] tracking-[-0.02em] break-words">
          {post.title}
        </h1>
      </header>
      
      {/* Article Body Content */}
      <article 
        class="article-prose text-paper/80 font-sans text-lg md:text-xl leading-relaxed break-words"
        set:html={post.content}
      />
      
      {/* Article Footer & Studio Callout */}
      <div class="mt-20 pt-12 border-t border-rule flex flex-col gap-12">
        {/* Studio Box */}
        <div class="p-8 md:p-10 border border-rule bg-press/40 backdrop-blur-md rounded-[4px] flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div class="max-w-md">
            <span className="font-mono text-[0.625rem] uppercase tracking-[0.2em] text-paper/40 block mb-2">
              Engineering Collaboration
            </span>
            <h3 className="text-2xl font-serif font-light text-paper mb-2">
              Membangun project bersama kami.
            </h3>
            <p className="text-paper/60 font-mono text-xs leading-relaxed">
              Diskusikan arsitektur sistem, timeline, dan spesifikasi teknis software Anda langsung dengan engineer kami di Bandar Lampung.
            </p>
          </div>
          <a 
            href="/#contact"
            className="inline-flex items-center border border-paper/30 px-6 py-3 text-paper font-mono text-xs uppercase tracking-[0.2em] bg-paper/5 hover:bg-paper hover:text-press transition-all duration-300 rounded-[2px] whitespace-nowrap"
          >
            Start a project
          </a>
        </div>

        {/* Back Link */}
        <div class="flex justify-between items-center font-mono text-xs uppercase tracking-[0.2em] text-paper/40">
          <a href="/blog" class="hover:text-paper hover:underline underline-offset-4 transition-colors">
            Return to Dispatches
          </a>
          <a href="#top" class="hover:text-paper transition-colors">
            Back to Top
          </a>
        </div>
      </div>
    </main>

    <Footer />
  </div>
</Layout>

<style is:global>
  /* Custom Article Prose Styling */
  .article-prose {
    color: rgba(242, 241, 237, 0.85);
  }
  .article-prose p {
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
    line-height: 1.75;
  }
  .article-prose h2 {
    font-family: var(--font-serif);
    font-size: 2rem;
    font-weight: 300;
    line-height: 1.2;
    color: var(--color-paper);
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.015em;
  }
  .article-prose h3 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 300;
    line-height: 1.3;
    color: var(--color-paper);
    margin-top: 2.25rem;
    margin-bottom: 1rem;
  }
  .article-prose ul, .article-prose ol {
    margin-top: 1.25rem;
    margin-bottom: 1.25rem;
    padding-left: 1.5rem;
  }
  .article-prose ul {
    list-style-type: disc;
  }
  .article-prose ol {
    list-style-type: decimal;
  }
  .article-prose li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }
  .article-prose blockquote {
    border-left: 2px solid rgba(242, 241, 237, 0.35);
    padding-left: 1.5rem;
    margin-top: 2rem;
    margin-bottom: 2rem;
    font-family: var(--font-serif);
    font-style: italic;
    color: rgba(242, 241, 237, 0.7);
    font-size: 1.25rem;
  }
  .article-prose code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: rgba(242, 241, 237, 0.08);
    border: 1px solid var(--color-rule);
    padding: 0.15em 0.4em;
    border-radius: 2px;
    color: var(--color-paper);
  }
  .article-prose pre {
    background-color: rgba(11, 10, 9, 0.8);
    border: 1px solid var(--color-rule);
    padding: 1.25rem;
    border-radius: 4px;
    overflow-x: auto;
    margin-top: 2rem;
    margin-bottom: 2rem;
  }
  .article-prose pre code {
    background: transparent;
    border: none;
    padding: 0;
  }
  .article-prose a {
    color: var(--color-paper);
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: rgba(242, 241, 237, 0.4);
    transition: text-decoration-color 0.2s ease;
  }
  .article-prose a:hover {
    text-decoration-color: var(--color-paper);
  }
  .article-prose hr {
    border: none;
    border-top: 1px solid var(--color-rule);
    margin-top: 3rem;
    margin-bottom: 3rem;
  }
</style>

