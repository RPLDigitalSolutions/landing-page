---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header';
import Footer from '../../components/Footer';
import { getDb } from '../../db';
import { articles } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { env } from 'cloudflare:workers';

const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/blog');
}

const db = getDb(env as any);
const post = await db.query.articles.findFirst({
  where: eq(articles.slug, slug)
});

if (!post) {
  return Astro.redirect('/404');
}
---

<Layout title={post.title}>
  <div class="max-w-5xl mx-auto px-6 md:px-12">
    <Header />
    <main class="py-24 min-h-[70vh]">
      <div class="mb-12">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">{post.title}</h1>
        <time class="text-zinc-500 font-mono">
          {new Date(post.createdAt).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          })}
        </time>
      </div>
      
      <article class="prose prose-invert prose-zinc max-w-none text-zinc-300 font-sans" set:html={post.content}>
      </article>
      
      <div class="mt-16 pt-8 border-t border-zinc-800">
        <a href="/blog" class="text-zinc-400 hover:text-white transition-colors uppercase tracking-widest text-sm">Back to Blog</a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

