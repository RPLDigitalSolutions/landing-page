---
import Layout from '../../../layouts/Layout.astro';
import { createAuth } from '../../../lib/auth';
import { env } from "cloudflare:workers";
import { getDb } from '../../../db';
import { users } from '../../../db/schema';
import { desc } from 'drizzle-orm';

const auth = createAuth(env as any);
const session = await auth.api.getSession({ headers: Astro.request.headers });

if (!session) {
  return Astro.redirect('/admin/login');
}

const db = getDb(env as any);
const allUsers = await db.query.users.findMany({
  orderBy: [desc(users.createdAt)]
});
---

<Layout title="Manage Users">
  <div class="min-h-screen bg-black text-white">
    <nav class="border-b border-zinc-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col sm:flex-row justify-between sm:h-20 items-center py-4 sm:py-0 gap-4">
          <div class="flex items-center w-full sm:w-auto justify-between">
            <a href="/admin/dashboard" class="text-xl font-bold tracking-tight text-white hover:text-zinc-300 transition-colors">CMS Dashboard</a>
          </div>
          <div class="flex items-center gap-4 sm:gap-6 overflow-x-auto w-full sm:w-auto pb-2 sm:pb-0">
            <a href="/admin/dashboard" class="text-sm text-zinc-400 hover:text-white transition-colors whitespace-nowrap">Articles</a>
            <a href="/admin/users" class="text-sm text-white font-medium whitespace-nowrap">Users</a>
            <a href="/admin/settings" class="text-sm text-zinc-400 hover:text-white transition-colors whitespace-nowrap">Settings</a>
            <button
              id="logout-btn"
              class="text-sm text-zinc-400 hover:text-white transition-colors whitespace-nowrap"
            >
              Sign out
            </button>
          </div>
        </div>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto py-8 sm:py-12 px-4 sm:px-6 lg:px-8">
      <div class="mb-8 sm:mb-12 flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
        <div>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight">Manage Users</h2>
          <p class="text-zinc-500 mt-1">View and manage system users</p>
        </div>
        <div class="flex items-center">
          <a href="/admin/users/edit" class="inline-flex items-center justify-center py-2.5 px-6 rounded-lg text-sm font-medium text-black bg-white hover:bg-zinc-200 transition-colors w-full sm:w-auto">
            Create User
          </a>
        </div>
      </div>

      <!-- Users List -->
      <div class="mt-8">
        <ul class="divide-y divide-zinc-800 border-y border-zinc-800">
          {allUsers.map((user) => (
            <li class="py-6 sm:py-8 flex flex-col sm:flex-row sm:items-center justify-between group gap-4 sm:gap-0">
              <div>
                <p class="text-white font-medium text-xl flex items-center gap-3">
                  {user.name}
                  {user.id === session.user.id && (
                    <span class="inline-flex items-center rounded-full bg-white px-2.5 py-0.5 text-xs font-medium text-black">
                      You
                    </span>
                  )}
                </p>
                <p class="text-zinc-500 text-base mt-1">@{user.username || 'unknown'}</p>
              </div>
              <div class="flex items-center justify-between sm:justify-end w-full sm:w-auto gap-4 sm:gap-8">
                <div class="text-left sm:text-right">
                  <p class="text-zinc-600 text-sm">
                    {new Date(user.createdAt).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
                  </p>
                </div>
                <div class="flex items-center gap-4">
                  <a href={`/admin/users/edit?id=${user.id}`} class="text-sm font-medium text-white hover:text-zinc-300 transition-colors border-b border-transparent hover:border-zinc-300 pb-1">
                    Edit
                  </a>
                  {user.id !== session.user.id && (
                    <button data-id={user.id} class="delete-user-btn text-sm font-medium text-red-500 hover:text-red-400 transition-colors border-b border-transparent hover:border-red-400 pb-1">
                      Delete
                    </button>
                  )}
                </div>
              </div>
            </li>
          ))}
          {allUsers.length === 0 && (
            <li class="py-12 text-center text-zinc-500 text-lg">No users found.</li>
          )}
        </ul>
      </div>
    </main>
  </div>
</Layout>

<script>
  import { authClient } from '../../../lib/auth-client';

  const logoutBtn = document.getElementById('logout-btn');
  logoutBtn?.addEventListener('click', async () => {
    await authClient.signOut();
    window.location.href = '/admin/login';
  });

  const deleteButtons = document.querySelectorAll('.delete-user-btn');
  
  deleteButtons.forEach(btn => {
    btn.addEventListener('click', async (e) => {
      const userId = (e.target as HTMLButtonElement).dataset.id;
      if (!userId) return;

      if (!confirm('Are you sure you want to delete this user? This action cannot be undone.')) {
        return;
      }

      const originalText = (e.target as HTMLButtonElement).textContent;
      (e.target as HTMLButtonElement).textContent = 'Deleting...';
      (e.target as HTMLButtonElement).disabled = true;

      try {
        const res = await fetch(`/api/users/${userId}`, {
          method: 'DELETE',
        });

        if (!res.ok) {
          const data = await res.json();
          throw new Error(data.error || 'Failed to delete user');
        }

        window.location.reload();
      } catch (err: any) {
        alert(err.message || 'An error occurred');
        (e.target as HTMLButtonElement).textContent = originalText;
        (e.target as HTMLButtonElement).disabled = false;
      }
    });
  });
</script>
