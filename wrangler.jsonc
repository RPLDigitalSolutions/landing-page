{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-18",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "landing-page",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "landing-page-db",
			"database_id": "76f170e1-8796-43b2-b7a7-ee5f33561cba",
			"migrations_dir": "drizzle"
		}
	],
	"kv_namespaces": [
		{
			"binding": "landing_page_session",
			"id": "adfb2274044f4e8c84ba8e1174da41dc"
		}
	]
}